{
  "name": "game-save-state",
  "version": "1.0.1",
  "type": "module",
  "description": "LocalStorage-based game save state manager with Set/Map serialization and optional toast UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "game",
    "save",
    "state",
    "localstorage",
    "persistence",
    "serialization",
    "set",
    "map",
    "game-dev",
    "indie"
  ],
  "author": "Luke Steuber <luke@lukesteuber.com>",
  "license": "MIT",
  "bugs": {
    "email": "luke@lukesteuber.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
